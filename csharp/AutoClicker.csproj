<Project Sdk="Microsoft.NET.Sdk">

  <!-- 本体（dll）。起動用の exe（Launcher）から読み込まれる -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>AutoClicker</AssemblyName>
    <RootNamespace>AutoClicker</RootNamespace>
    <Version>1.15.2</Version>
    <AssemblyVersion>1.15.2.0</AssemblyVersion>
    <Product>Auto Clicker</Product>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- 起動用とインストーラーは別のプロジェクトなので、本体には含めない -->
  <ItemGroup>
    <Compile Remove="Launcher/**;Installer/**" />
  </ItemGroup>

  <!-- 画像・言語ファイルは既存の Python 版と共有して埋め込む -->
  <ItemGroup>
    <EmbeddedResource Include="..\images\*.png" LogicalName="images.%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\languages\*.lang" LogicalName="languages.%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\app_icon.ico" LogicalName="app_icon.ico" />
  </ItemGroup>

</Project>
